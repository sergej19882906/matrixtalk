# === Matrix Talk Server Configuration ===
# Copy this file to .env and fill in the values.
# DO NOT commit .env to version control.

# --- Homeserver ---
# Your Matrix server domain (must match DNS / reverse proxy)
MATRIX_SERVER_NAME=example.org

# --- PostgreSQL ---
POSTGRES_USER=synapse
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=synapse

# --- TURN Server (VoIP audio/video calls) ---
# Shared secret for TURN authentication (generate: openssl rand -hex 32)
TURN_SHARED_SECRET=replace-with-a-long-random-secret
# TURN/STUN UDP port
TURN_PORT=3478
# TURN TLS port (requires certs in server-data/coturn/)
TURN_TLS_PORT=5349
# Media relay port range (open these UDP ports in your firewall)
TURN_MIN_PORT=49152
TURN_MAX_PORT=65535

# --- Synapse Admin ---
# Secret for register_new_matrix_user (generate: openssl rand -hex 32)
SYNAPSE_REGISTRATION_SHARED_SECRET=replace-with-another-random-secret
# Web UI port for server administration (http://<server>:8080)
SYNAPSE_ADMIN_PORT=8080

# --- Optional ntfy Matrix gateway (Compose profile: push) ---
# HTTPS origin only; must also be configured in the Android APK manifest metadata
# com.matrix.messenger.NTFY_BASE_URL and the phone ntfy default server.
# Empty disables configured instant push; /_matrix/push/v1/notify is the gateway,
# not a device topic endpoint. See docs/bridges.md.
NTFY_BASE_URL=
NTFY_PORT=2586

# --- Optional bridges ---
# Use separate bridge-* profiles; prepare pinned upstream config + registration
# files first. These hints DO NOT rewrite mautrix config files; see docs/bridges.md.
# Telegram API credentials must be entered into the prepared bridge config.
# Get from https://my.telegram.org/apps
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Full owner MXID required for heisenbridge; set permissions in each mautrix config.
BRIDGE_ADMIN=
